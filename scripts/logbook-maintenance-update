#!/usr/bin/python3 -I
"""Fixed root entry for explicitly delegated signed maintenance; no arguments."""
import os
import re
import stat
import sys
import hashlib
import subprocess
import tempfile
from pathlib import Path

CODE_ROOT = Path('/Library/Application Support/LogbookPlanProducer/lib')


def selected_code_root():
    base = CODE_ROOT.parent
    pointer = base/'source.current'
    if not os.path.lexists(pointer):
        return CODE_ROOT
    check_trusted_file(pointer)
    value = pointer.read_text().strip()
    if not re.fullmatch(r'[a-f0-9]{64}',value):
        raise ValueError('invalid source generation pointer')
    return base/'releases'/value


def check_trusted_directory(path):
    info = path.lstat()
    if (not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022):
        raise ValueError('producer code directory is not root controlled')


def check_trusted_file(path):
    info = path.lstat()
    if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022):
        raise ValueError('producer code file is not root controlled')


def main():
    if os.geteuid() != 0 or sys.argv[1:]:
        raise SystemExit('root and no arguments required')
    code_root = selected_code_root()
    for ancestor in (code_root, *code_root.parents):
        check_trusted_directory(ancestor)
    for current,directories,files in os.walk(code_root,followlinks=False):
        for name in directories:
            check_trusted_directory(Path(current)/name)
        for name in files:
            check_trusted_file(Path(current)/name)
    sys.dont_write_bytecode = True
    sys.path.insert(0,str(code_root))
    # The installed generation supplies only the stable policy/signature verifier
    # and fetcher. Execute the freshly verified installer's code, so a bug in an
    # older source installer cannot prevent its own routine replacement.
    from logbook import operator_bundle_bootstrap as bootstrap
    from logbook.repair_release_delivery import fetch_candidate, REPOSITORY
    guard = CODE_ROOT.parent/'maintenance'
    bootstrap.trusted_parent(guard/'check')
    if bootstrap.signed_policy(guard)['schema'] != 4:
        raise ValueError('owner maintenance delegation required')
    manifest,signature,data = fetch_candidate(REPOSITORY)
    bootstrap.receive_release(guard,manifest,signature,_source=True)
    release = bootstrap.approved_release(guard)
    if hashlib.sha256(data).hexdigest() != release['bundle_sha256']:
        raise ValueError('signed source installer package mismatch')
    if code_root.name == release['bundle_sha256']:
        print('UNCHANGED')
        return
    with tempfile.TemporaryDirectory(prefix='.signed-source-installer-',dir=guard) as temporary:
        work = Path(temporary)
        bootstrap.install_bundle(data,work/'runtime',release['bundle_sha256'])
        package = work/'bundle.tar.gz'
        package.write_bytes(data)
        package.chmod(0o600)
        driver = ("import sys;from pathlib import Path;sys.path.insert(0,sys.argv[1]);"
                  "from logbook.source_maintenance import install_source_release;"
                  "print(install_source_release(Path(sys.argv[2]).read_bytes()))")
        subprocess.run(['/usr/bin/python3','-I','-c',driver,str(work/'runtime'),str(package)],check=True)


if __name__ == '__main__':
    main()
