#!/usr/bin/env bash
set -euo pipefail
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="$repo_root/src${PYTHONPATH:+:$PYTHONPATH}"

# Select by local configuration, not hostname: this also works over SSH.
explicit_env=false
explicit_config=false
for arg in "$@"; do
  case "$arg" in
    --env|--env=*) explicit_env=true ;;
    --config|--config=*) explicit_config=true ;;
    -h|--help)
      cat <<'HELP'
Usage: scripts/remote-watch [--once] [--env FILE | --config FILE]

On mimir: watches transcription and Obsidian publication using the checkout .env.
On a MacBook: watches the local recording buffer and upload receipts.
A receipt confirms delivery, not transcription or publication.

Selection: explicit --env/--config, then LOGBOOK_REMOTE_CONFIG, then the existing
~/Library/Application Support/LogbookRemotePilot/remote-agent.json, then .env.
--once prints one snapshot; otherwise watch refreshes until Ctrl-C.
Additional options are passed to the selected watcher (e.g. --ui curses on mimir).
HELP
      exit 0 ;;
  esac
done

if "$explicit_env" && "$explicit_config"; then
  echo 'Choose either --env or --config, not both.' >&2
  exit 2
fi
if "$explicit_env"; then
  exec "$repo_root/.venv/bin/python" -m logbook.cli watch "$@"
elif "$explicit_config"; then
  exec "$repo_root/.venv/bin/python" -m logbook.remote_cli watch "$@"
fi

agent_config="${LOGBOOK_REMOTE_CONFIG:-$HOME/Library/Application Support/LogbookRemotePilot/remote-agent.json}"
if [[ -n "${LOGBOOK_REMOTE_CONFIG:-}" || -f "$agent_config" ]]; then
  exec "$repo_root/.venv/bin/python" -m logbook.remote_cli watch --config "$agent_config" "$@"
elif [[ -f "$repo_root/.env" ]]; then
  exec "$repo_root/.venv/bin/python" -m logbook.cli watch --env "$repo_root/.env" "$@"
fi

echo 'No watch configuration found. Use --env FILE on mimir or --config FILE on the MacBook.' >&2
exit 2
