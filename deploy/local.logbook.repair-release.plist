<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.logbook.repair-release</string>
    <key>UserName</key>
    <string>logbook-repair-operator</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/libexec/logbook-plan-producer</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Library/Application Support/LogbookRepairOperator</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>StandardOutPath</key>
    <string>/Library/Application Support/LogbookRepairOperator/private/release-delivery.log</string>
    <key>StandardErrorPath</key>
    <string>/Library/Application Support/LogbookRepairOperator/private/release-delivery.log</string>
</dict>
</plist>
